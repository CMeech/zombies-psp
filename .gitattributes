# Normalize text files in the repository while preserving platform-specific scripts.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets out of text conversion and textual diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.pbp binary
*.sfo binary
*.elf binary
*.prx binary
*.iso binary
*.cso binary
